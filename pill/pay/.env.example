# Copy to .env (git-ignored). Never commit real values.
# CDP Portal → API keys: https://portal.cdp.coinbase.com/api-keys/secret
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# CDP Portal → Server Wallet → wallet secret (needed to sign transfers and x402 payments)
CDP_WALLET_SECRET=
# Address that receives x402 payments for POST /verify (e.g. the pill-escrow account address)
X402_PAY_TO=

# Optional
PORT=8402
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://127.0.0.1:5183,http://localhost:5183,http://127.0.0.1:5186,http://localhost:5186,http://127.0.0.1:5189,http://localhost:5189,http://127.0.0.1:5191,http://localhost:5191,http://127.0.0.1:5195,http://localhost:5195,http://localhost:5173
# Base Sepolia RPC the checkout watcher reads USDC Transfer logs from (public default; https://base-sepolia-rpc.publicnode.com also works)
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Facilitator used when CDP keys are missing (public, Base Sepolia only)
PUBLIC_FACILITATOR_URL=https://x402.org/facilitator
# Force a mode: cdp | public-facilitator | simulated (default: pick the strongest one the env allows)
MODE=
# Escrow: invoice dollars × ESCROW_SCALE = test USDC actually moved (the CDP faucet hands out 1 USDC per claim)
ESCROW_SCALE=0.0001
# Buyer without CDP keys: a funded Base Sepolia private key that pays through the public facilitator
BUYER_PRIVATE_KEY=

# App model features (keys stay here; see README "Models, speech and the Nessie mirror")
# Claude: POST /why, POST /escrow-log and POST /ask (without it: deterministic rule text / policy outcome, mode:'template')
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Gemini (server-side only; also set on Vercel for pill-app's /api functions): POST /api/label, /api/check (checker),
# /api/assist (follower). Without the key: label mode:'unavailable' (the app fills demo values); the checker still runs
# its code tools (recall lookup, cross-check, reconcile) and a template summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Checker: vision, summary and label reads / its function-calling rounds
GEMINI_CHECKER_MODEL=gemini-3.1-pro-preview
GEMINI_CHECKER_TOOLS_MODEL=gemini-3.1-pro-preview-customtools
# Tried in order after the first model fails (429 quota, 20 s timeout, 5xx, empty reply)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# Best-effort spend limit per instance: requests/day across all Gemini routes (plus 10/min and 100/day per IP) → 429 {mode:'busy'}
GEMINI_DAILY_CAP=2000
# Follower assistant: POST /api/assist (SSE) and /api/assist-tip; falls through GEMINI_FALLBACK_MODELS on 429 / no text in 12 s
GEMINI_FOLLOWER_MODEL=gemini-3.5-flash
# Capital One Nessie SANDBOX fiat mirror of the escrow (without it: mode:'unavailable', nothing mirrored)
NESSIE_KEY=
NESSIE_BASE=https://api.nessieisreal.com
# ElevenLabs read-aloud: POST /speak (without it: the app uses the browser voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# Tiger Data / TimescaleDB: Postgres connection string for the samples hypertable (POST /tiger/samples, GET /tiger/status,
# GET /tiger/plateau/:run_id). Without it every /tiger route answers {mode:'unavailable'}.
TIGER_URL=
